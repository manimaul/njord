# syntax=docker/dockerfile:1
# Builds a Raspberry Pi 64-bit (ARM64) Debian package. Build it for --platform linux/arm64: the
# Rust toolchain then compiles natively inside the container (native on an Apple Silicon or ARM
# host, QEMU emulation on x86_64), so there is no cross-linker or ARM64 sysroot to set up.
#
# Build & extract the .deb:
#   cd <repo-root>
#   bash debpkg/build_deb_arm64.sh
#
# Or manually:
#   podman build --platform linux/arm64 \
#       --ignorefile debpkg/containerignore \
#       --output type=local,dest=./debpkg/ \
#       --target artifact \
#       -f debpkg/Containerfile.arm64 .

ARG RUST_IMAGE=docker.io/library/rust:1.99.1-trixie

FROM ${RUST_IMAGE} AS builder

# libgdal-dev: njord-s57 links GDAL (prebuilt bindings for Debian's GDAL 3.10, no bindgen).
# python3 + dpkg-deb (in the base image) run build_deb.py.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    pkg-config \
    python3 \
    && rm -rf /var/lib/apt/lists/*

ARG TRUNK_VERSION=0.22.1
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-arm64,sharing=locked \
    rustup target add wasm32-unknown-unknown \
    && cargo install --locked "trunk@${TRUNK_VERSION}"

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY data ./data
COPY debpkg ./debpkg

# target/ is a cache mount, so the binary and the UI are copied out of it before build_deb.py
# runs. See the root Containerfile for why the sources are touched first.
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-arm64,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-arm64,sharing=locked \
    --mount=type=cache,target=/build/target,id=cargo-target-arm64,sharing=locked \
    --mount=type=cache,target=/root/.cache/trunk,id=trunk-arm64,sharing=locked \
    find crates Cargo.toml Cargo.lock -type f -exec touch {} + \
    && cargo build --release -p njord-server --locked \
    && install -D -m 0755 target/release/njord-server /out/njord-server \
    && (cd crates/njord-web && trunk build --release --locked --dist /out/www)

# build_deb.py looks for the build outputs at their usual repository paths.
RUN install -D -m 0755 /out/njord-server target/release/njord-server \
    && mkdir -p crates/njord-web && cp -r /out/www crates/njord-web/dist \
    && python3 debpkg/build_deb.py --architecture arm64

# Export stage: copies only the .deb so --output extracts just the package.
FROM scratch AS artifact
COPY --from=builder /build/debpkg/njord_*.deb /
