#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    ln -sf /etc/njord/application.json /usr/lib/njord/config/application.json

    # A per-install admin signing key. Not a conffile: generated once, kept on upgrade, removed on purge.
    ENV_FILE=/etc/njord/njord.env
    if [ ! -f "$ENV_FILE" ]; then
        KEY=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48)
        umask 027
        printf '# Generated by the njord package. CHART_SERVER_OPTS is merged over application.json.\n' > "$ENV_FILE"
        printf "CHART_SERVER_OPTS='{\"adminKey\":\"%s\"}'\n" "$KEY" >> "$ENV_FILE"
        chown root:njord "$ENV_FILE"
        chmod 0640 "$ENV_FILE"
    fi

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if [ -z "$2" ]; then
            # First install: start at boot, but not now; the database has to be set up first.
            systemctl enable njord.service
        else
            # Upgrade: pick up the new binary if it was running.
            systemctl try-restart njord.service
        fi
    fi

    if [ -z "$2" ]; then
        echo "Njord is installed and enabled at boot, but not started. Next:"
        echo "  1. Edit /etc/njord/application.json; change adminUser/adminPass and the"
        echo "     pgConnectionInfo password from the admin/admin defaults."
        echo "  2. sudo /usr/share/njord/db_setup.sh"
        echo "  3. sudo systemctl start njord"
    fi
fi
