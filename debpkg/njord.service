[Unit]
Description=Njord Marine ENC Chart Server
Documentation=https://github.com/manimaul/njord
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
User=njord
Group=njord
WorkingDirectory=/usr/lib/njord
# CHART_SERVER_OPTS with this install's adminKey, generated by postinst.
EnvironmentFile=/etc/njord/njord.env
ExecStart=/usr/lib/njord/njord-server /usr/lib/njord
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=njord

# chartTempData (uploads, region archives, tile cache): /var/lib/njord, owned by njord and kept
# across restarts. /tmp is private to the service and emptied whenever it stops.
StateDirectory=njord
StateDirectoryMode=0750

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
