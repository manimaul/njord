# Rust Njord chart server image: ghcr.io/manimaul/njord (docs/RUST_PORT_PLAN.md §10).
#
# NEVER tag or push this image as ghcr.io/manimaul/njord-chart-server. That repository belongs to
# the Kotlin environment in the `njord` namespace, which pulls it with imagePullPolicy: Always, so a
# Rust build pushed there would be picked up by the old environment on its next pod start
# (§10.2 item 1). deploy/mxmariner/deploy.sh refuses to build or push under that name.
#
# Build it through the script, which passes the matching ignore file (it keeps the multi-GB Cargo
# target/ directory out of the build context):
#
#   deploy/mxmariner/deploy.sh --execute build
#
# or by hand:
#
#   podman build --platform linux/amd64 \
#     --ignorefile deploy/mxmariner/containerignore \
#     -f Containerfile.rust -t ghcr.io/manimaul/njord:<version> .

ARG RUST_IMAGE=docker.io/library/rust:1.99.1-trixie
ARG RUNTIME_IMAGE=docker.io/library/debian:13.7-slim

FROM ${RUST_IMAGE} AS builder

# libgdal-dev: GDAL is linked only by the njord-s57 crate, which njord-server links for ingest
# (Phase 4). The pinned georust gdal commit ships prebuilt bindings for Debian's GDAL 3.10, so no
# libclang / bindgen is needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# The web UI (crates/njord-web) is built with Trunk for wasm32. Its own layer, so it is compiled
# once and reused until the version changes. Trunk downloads the wasm-bindgen CLI matching
# Cargo.lock and wasm-opt on first use (cached under /root/.cache/trunk below).
ARG TRUNK_VERSION=0.22.1
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    rustup target add wasm32-unknown-unknown \
    && cargo install --locked "trunk@${TRUNK_VERSION}"

WORKDIR /build

# Only the Cargo workspace. Everything else in the repository is excluded by
# deploy/mxmariner/containerignore, so doc or deploy changes do not invalidate this layer.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Optional build metadata, resolved on the host by deploy.sh (git cannot see the repository from
# inside the build). Exposed to the build as environment variables for option_env!().
ARG GIT_HASH=unknown
ARG GIT_BRANCH=unknown
ARG GIT_DIRTY=unknown
ENV NJORD_GIT_HASH=${GIT_HASH} NJORD_GIT_BRANCH=${GIT_BRANCH} NJORD_GIT_DIRTY=${GIT_DIRTY}

# target/ is a cache mount, so it is not part of any layer: copy the binaries out in the same step.
# COPY keeps the host mtimes, and cargo's fingerprints are mtime based, so a source file older
# than the cached build output would be taken as unchanged (seen in practice: a file edited
# during a build). Touching the workspace sources rebuilds only the njord-* crates; third-party
# dependencies stay cached.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    --mount=type=cache,target=/root/.cache/trunk,sharing=locked \
    find crates Cargo.toml Cargo.lock -type f -exec touch {} + \
    && cargo build --release -p njord-server -p njord-enc-cron --locked \
    && install -D -m 0755 target/release/njord-server /out/njord-server \
    && install -D -m 0755 target/release/njord-ingest /out/njord-ingest \
    && install -D -m 0755 target/release/njord-enc-cron /out/njord-enc-cron \
    && (cd crates/njord-web && trunk build --release --locked --dist /out/www)

FROM ${RUNTIME_IMAGE}

# Compare the Kotlin image (the root Containerfile, removed in Phase 7), which also needed libpq5, libzip5, libssl3t64,
# libcurl4t64, libgd3 and libexpat1: all of those are now statically linked Rust (§4.3).
#   ca-certificates  TLS roots for outbound HTTPS (NOAA downloads from Phase 5, any rustls/openssl
#                    client that uses the system store).
#   libgdal36        Runtime GDAL 3.10 for njord-s57, linked by njord-server since ingestion moved
#                    into this binary (Phase 4; check with `ldd /opt/njord/njord-server`). Drop it
#                    only if a separate ingest image is built instead (§4.3, last sentence).
#                    SQLite (region archives) is the bundled rusqlite build, not a package.
#   zlib1g           libz-sys links the system zlib when the builder has it (it does), so the
#                    binary needs libz.so.1. Already in debian slim; listed so it is not lost.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgdal36 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/njord-server /out/njord-ingest /out/njord-enc-cron /opt/njord/

# Same layout as the Kotlin image, so the njord-config ConfigMap (mounted over
# resources/config/application.json) and webStaticContent=/opt/njord/resources/www keep working.
COPY crates/njord-server/resources /opt/njord/resources
COPY deploy/mxmariner/application.json /opt/njord/resources/config/application.json
# The Leptos UI, merged over resources/www, which already holds fonts/ and sprites/.
COPY --from=builder /out/www /opt/njord/resources/www
# njord-enc-cron's resources dir; the njord-enc-cron-config ConfigMap is mounted over
# config/enc_cron.json.
COPY crates/njord-enc-cron/resources /opt/njord/enc_cron_resources

EXPOSE 9000

# Same CLI shape as the Kotlin server: njord-server <resources dir>, with CHART_SERVER_OPTS JSON
# overlaid on <resources dir>/config/application.json. njord-ingest takes the same arguments
# (workers only, no HTTP); njord-enc-cron takes /opt/njord/enc_cron_resources.
CMD ["/opt/njord/njord-server", "/opt/njord/resources"]
